// aibah — e-commerce (guest checkout) · source of truth, mirrors AGENTS.md
// Money: integer minor units (*_cents) + currency char(3). Never floats.
// Prisma 7 (7.10.0) · generator: prisma-client · runtime driver adapter: @prisma/adapter-pg

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  draft
  active
  archived
}

enum MediaType {
  image
  video
}

enum ProductMediaRole {
  gallery
  featured
}

enum CartStatus {
  active
  converted
  abandoned
  expired
}

enum OrderStatus {
  pending
  paid
  fulfilled
  delivered
  closed
  cancelled
  refunded
}

enum AddressType {
  shipping
  billing
}

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  refunded
}

enum ShipmentStatus {
  pending
  in_transit
  delivered
  returned
}

enum DiscountType {
  percentage
  fixed
  free_shipping
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum EmailStatus {
  queued
  sent
  failed
}

enum WebhookStatus {
  received
  processed
  failed
}

enum AnalyticsEventType {
  page_view
  product_view
  add_to_cart
  purchase
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  description String?
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  options         ProductOption[]
  variants        ProductVariant[]
  media           ProductMedia[]
  categories      ProductCategory[]
  reviews         Review[]
  analyticsEvents AnalyticsEvent[]

  @@index([status])
  @@map("products")
}

model ProductOption {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int    @default(0)

  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  value    String
  position Int    @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  sku                 String   @unique
  priceCents          Int      @map("price_cents")
  compareAtPriceCents Int?     @map("compare_at_price_cents")
  stockQuantity       Int      @default(0) @map("stock_quantity")
  lowStockThreshold   Int      @default(0) @map("low_stock_threshold")
  weightGrams         Int?     @map("weight_grams")
  isDefault           Boolean  @default(false) @map("is_default")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  parent   Category?          @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]         @relation("CategoryToCategory")
  products ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  url         String
  type        MediaType @default(image)
  width       Int?
  height      Int?
  blurDataUrl String?   @map("blur_data_url")
  alt         String?
  sizeBytes   Int?      @map("size_bytes")
  createdAt   DateTime  @default(now()) @map("created_at")

  products    ProductMedia[]
  reviewMedia ReviewMedia[]

  @@map("media")
}

model ProductMedia {
  productId String           @map("product_id") @db.Uuid
  mediaId   String           @map("media_id") @db.Uuid
  role      ProductMediaRole @default(gallery)
  sortOrder Int              @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId])
  @@map("product_media")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  token     String     @unique @db.Uuid
  email     String?
  currency  String     @db.Char(3)
  status    CartStatus @default(active)
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")

  items  CartItem[]
  orders Order[]

  @@index([status, expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  orderNumber      String      @unique @map("order_number")
  cartId           String?     @map("cart_id") @db.Uuid
  email            String
  status           OrderStatus @default(pending)
  currency         String      @db.Char(3)
  subtotalCents    Int         @map("subtotal_cents")
  discountCents    Int         @default(0) @map("discount_cents")
  shippingCents    Int         @default(0) @map("shipping_cents")
  taxCents         Int         @default(0) @map("tax_cents")
  totalCents       Int         @map("total_cents")
  discountCode     String?     @map("discount_code")
  guestAccessToken String      @unique @map("guest_access_token")
  placedAt         DateTime?   @map("placed_at")
  internalNotes    String?     @map("internal_notes")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")

  cart            Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  addresses       OrderAddress[]
  payments        Payment[]
  shipments       Shipment[]
  redemptions     DiscountRedemption[]
  analyticsEvents AnalyticsEvent[]

  @@index([email])
  @@index([status, placedAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  // snapshots — orders must never depend on current catalog state
  productName    String   @map("product_name")
  variantOptions Json     @default("{}") @map("variant_options")
  sku            String
  imageUrl       String?  @map("image_url")
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int      @map("line_total_cents")
  createdAt      DateTime @default(now()) @map("created_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([orderId])
  @@map("order_items")
}

model OrderAddress {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @map("order_id") @db.Uuid
  type       AddressType
  name       String
  phone      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String      @map("postal_code")
  country    String      @db.Char(2)
  createdAt  DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("order_addresses")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  provider     String        @default("stripe")
  providerRef  String        @map("provider_ref")
  status       PaymentStatus @default(pending)
  amountCents  Int           @map("amount_cents")
  currency     String        @db.Char(3)
  errorMessage String?       @map("error_message")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  reason      String?
  providerRef String   @unique @map("provider_ref")
  createdAt   DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  carrier        String
  trackingNumber String         @map("tracking_number")
  status         ShipmentStatus @default(pending)
  shippedAt      DateTime?      @map("shipped_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model DiscountCode {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  type             DiscountType
  value            Int
  minSubtotalCents Int          @default(0) @map("min_subtotal_cents")
  maxUses          Int?         @map("max_uses")
  usedCount        Int          @default(0) @map("used_count")
  perEmailLimit    Int?         @map("per_email_limit")
  startsAt         DateTime?    @map("starts_at")
  endsAt           DateTime?    @map("ends_at")
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  redemptions DiscountRedemption[]

  @@map("discount_codes")
}

model DiscountRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  discountCodeId String   @map("discount_code_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  email          String
  createdAt      DateTime @default(now()) @map("created_at")

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, discountCodeId])
  @@index([email])
  @@map("discount_redemptions")
}

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  displayName String       @map("display_name")
  rating      Int
  body        String       @db.Text
  status      ReviewStatus @default(pending)
  orderItemId String?      @map("order_item_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  media     ReviewMedia[]

  @@index([productId, status])
  @@map("reviews")
}

model ReviewMedia {
  reviewId String @map("review_id") @db.Uuid
  mediaId  String @map("media_id") @db.Uuid

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([reviewId, mediaId])
  @@map("review_media")
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  provider    String        @default("stripe")
  eventId     String        @unique @map("event_id")
  type        String
  payload     Json
  status      WebhookStatus @default(received)
  error       String?
  receivedAt  DateTime      @default(now()) @map("received_at")
  processedAt DateTime?     @map("processed_at")

  @@index([status])
  @@map("webhook_events")
}

model EmailLog {
  id          String      @id @default(uuid()) @db.Uuid
  toEmail     String      @map("to_email")
  template    String
  subject     String
  status      EmailStatus @default(queued)
  providerRef String?     @map("provider_ref")
  error       String?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([toEmail])
  @@map("email_log")
}

model AnalyticsEvent {
  id           String             @id @default(uuid()) @db.Uuid
  type         AnalyticsEventType
  sessionToken String?            @map("session_token")
  productId    String?            @map("product_id") @db.Uuid
  orderId      String?            @map("order_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime           @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@map("analytics_events")
}